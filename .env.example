# Copie ce fichier en .env.local et remplis-le toi-même. Ne mets JAMAIS ces valeurs dans le chat, ni dans Git.
# Aucune de ces variables n'est préfixée NEXT_PUBLIC_ : aucune n'atteint le navigateur.

# Strava : https://www.strava.com/settings/api  (Authorization Callback Domain : localhost, puis ton domaine Vercel)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Ton identifiant d'athlète (le nombre dans l'URL de ton profil : strava.com/athletes/<id>)
OWNER_ATHLETE_ID=

# Supabase : Project Settings > API Keys. Utilise la clé SECRÈTE (sb_secret_...), jamais la clé publique.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Chaîne aléatoire d'au moins 32 caractères, pour signer le cookie de session.
SESSION_SECRET=

# Chaîne aléatoire de ton choix : Strava la renvoie pour prouver que le webhook t'appartient (voir scripts/strava-subscribe.mjs).
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Optionnel : secret pour appeler /api/strava/sync depuis une tâche planifiée (Authorization: Bearer ...).
CRON_SECRET=
